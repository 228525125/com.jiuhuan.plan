<?xml version='1.0' encoding='utf-8'?>
<SettingsFile xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/settings" CurrentProfile="(Default)" GeneratedClassNamespace="com.jiuhuan.plan" GeneratedClassName="Config">
  <Profiles />
  <Settings>
    <Setting Name="image_home" Type="System.String" Scope="User">
      <Value Profile="(Default)">home.png</Value>
    </Setting>
    <Setting Name="icon_logo" Type="System.String" Scope="User">
      <Value Profile="(Default)">logo.ico</Value>
    </Setting>
    <Setting Name="database_server" Type="System.String" Scope="User">
      <Value Profile="(Default)">192.168.1.209</Value>
    </Setting>
    <Setting Name="database_user" Type="System.String" Scope="User">
      <Value Profile="(Default)">sa</Value>
    </Setting>
    <Setting Name="database_password" Type="System.String" Scope="User">
      <Value Profile="(Default)">hao123.com</Value>
    </Setting>
    <Setting Name="database_name" Type="System.String" Scope="User">
      <Value Profile="(Default)">plan</Value>
    </Setting>
    <Setting Name="database_timeout" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">60</Value>
    </Setting>
    <Setting Name="database_reconnect_time" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">5</Value>
    </Setting>
    <Setting Name="sql_machine_team_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT TEAM_CODE AS FCode,TEAM_DESCRIPTION AS FName,TEAM_CAPACITY AS FCapacity,TEAM_RATIO AS FRatio,REMARK AS FRemark FROM CQJH.dbo.MACHINE_TEAM</Value>
    </Setting>
    <Setting Name="task_helper_interval_default" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">1000</Value>
    </Setting>
    <Setting Name="log_upload_interval" Type="System.Int32" Scope="User">
      <Value Profile="(Default)">2000</Value>
    </Setting>
    <Setting Name="sql_workday_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM Workday</Value>
    </Setting>
    <Setting Name="sql_workday_deleteall" Type="System.String" Scope="User">
      <Value Profile="(Default)">DELETE Workday</Value>
    </Setting>
    <Setting Name="sql_mo_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT m1.DOC_NO as FBillNo,m1.DOC_DATE as FDate,i1.ITEM_CODE as FNumber,i1.ITEM_NAME as FName,i1.ITEM_SPECIFICATION as FModel
, CASE WHEN m1.STATUS = '1' THEN '未生产'
	   WHEN m1.STATUS = '2' THEN '已发料'
	   WHEN m1.STATUS = '3' THEN '生产中'
  END AS FState
,MIS.是否缺料 AS FLack                  --是否缺料
,PLAN_QTY as FQty
,COMPLETED_QTY as FCompletedQty           --完工数量
,SCRAP_QTY as FScrapQty                   --报废数量
,XRECEIPT_SETS as FReceiptQty             --退料数量
,PLAN_START_DATE as FPlanStartDate        --计划开工
,PLAN_COMPLETE_DATE as FPlanCompletedDate --计划完工
,m1.REMARK as FRemark
FROM CQJH.dbo.MO m1
INNER JOIN CQJH.dbo.ITEM i1 ON m1.ITEM_ID=i1.ITEM_BUSINESS_ID
LEFT JOIN v_MoInventoryStatus MIS ON m1.DOC_NO = MIS.工单号
WHERE 1=1
AND m1.RELEASE_FLAG=1         --下达
AND m1.STATUS IN ('1','2','3')   --1：未生产；2：已发料；3：生产中
AND m1.PLAN_COMPLETE_DATE &gt;= '{0}' AND m1.PLAN_COMPLETE_DATE &lt;= '{1}'</Value>
    </Setting>
    <Setting Name="sql_work_center_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT WORK_CENTER_CODE,WORK_CENTER_NAME FROM CQJH.dbo.WORK_CENTER</Value>
    </Setting>
    <Setting Name="v_operation_findall_by_mo" Type="System.String" Scope="User">
      <Value Profile="(Default)">select * from v_operation_findall_by_mo where FBillNo in ({0})</Value>
    </Setting>
    <Setting Name="v_schedule_record_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM v_ScheduleRecord WHERE 1=1</Value>
    </Setting>
    <Setting Name="v_operation_record_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM v_OperationRecord WHERE 1=1</Value>
    </Setting>
    <Setting Name="v_schedule_details_record_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM v_ScheduleDetailsRecord WHERE 1=1</Value>
    </Setting>
    <Setting Name="sql_user_name_password" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM [User] WHERE FName='{0}' AND FPassword='{1}'</Value>
    </Setting>
    <Setting Name="v_schedule_final_record_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM v_ScheduleFinalRecord WHERE 1=1</Value>
    </Setting>
    <Setting Name="v_schedule_final_findall_by_mo" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT m1.DOC_NO as FBillNo
,i1.ITEM_CODE as FNumber
,i1.ITEM_NAME as FName
,i1.ITEM_SPECIFICATION as FModel
,CASE WHEN m1.STATUS = '1' THEN '未生产'
       WHEN m1.STATUS = '2' THEN '已发料'
       WHEN m1.STATUS = '3' THEN '生产中'
       WHEN m1.STATUS = 'Y' THEN '已完工'
       WHEN m1.STATUS = 'y' THEN '指定完工'
    END AS FState
,m3.SequenceNumber as FOperationId
,m3.OPERATION_SEQ as FOperationNumber
,o1.OPERATION_NAME as FOperationName
,m1.PLAN_COMPLETE_DATE as FMoPlanCompleteDate    
,m1.PLAN_QTY as FQty                               --计划数量
,m1.COMPLETED_QTY as FCompletedQty                 --入库数量 
,ISNULL(m6.ISSUED_QTY,0) as FDispatchedQty         --投入数
,m3.COLLECT_QTY as FCollectQty                     --工序报工数
,m1.PLAN_QTY + ISNULL(m6.TRANSFER_IN_QTY,0) - ISNULL(m6.SCRAP_QTY,0) - ISNULL(m6.COMPLETED_QTY,0) - ISNULL(m6.DESTROYED_QTY,0) as FRemainQty               --工序待加工数   工序待加工数=工单数量+工序投入调整量-工序报废数量-工序完成数量-工序破坏数量
,CAST(CASE WHEN (m1.PLAN_QTY + ISNULL(m6.TRANSFER_IN_QTY,0) - ISNULL(m6.SCRAP_QTY,0) - ISNULL(m6.COMPLETED_QTY,0) - ISNULL(m6.DESTROYED_QTY,0)) = ISNULL(m6.ISSUED_QTY,0) THEN (m1.PLAN_QTY + ISNULL(m6.TRANSFER_IN_QTY,0) - ISNULL(m6.SCRAP_QTY,0) - ISNULL(m6.COMPLETED_QTY,0) - ISNULL(m6.DESTROYED_QTY,0)) * ir1.DYNAMIC_MAN_HOUR + ir1.FIXED_MAN_HOUR
      ELSE (m1.PLAN_QTY + ISNULL(m6.TRANSFER_IN_QTY,0) - ISNULL(m6.SCRAP_QTY,0) - ISNULL(m6.COMPLETED_QTY,0) - ISNULL(m6.DESTROYED_QTY,0)) * ir1.DYNAMIC_MAN_HOUR END AS INT) as FNeedWorkHours            --需要工时/秒,ir1.FIXED_MAN_HOUR as FAidedWorkHour              --辅助工时
,ir1.FIXED_MAN_HOUR as FAidedWorkHour              --辅助工时
,ir1.DYNAMIC_MAN_HOUR as FStandardWorkHours        --单套标准工时
,GETDATE() AS FOperationPlanStartDate              --工序预计开工时间
,GETDATE() AS FOperationPlanCompleteDate           --工序预计完工时间
,MIS.是否缺料 AS FLack                           --是否缺料
,CAST(0 AS BIT) AS FTimeout                        --是否超期
,CASE WHEN w1.WORK_CENTER_NAME='制造一科' THEN '032-小巨人'
      WHEN w1.WORK_CENTER_NAME='制造三科' THEN '030-纵切西铁城'
      WHEN w1.WORK_CENTER_NAME='制造四科' THEN '505-装配'
      WHEN w1.WORK_CENTER_NAME='品质部' THEN '001-排液塞友嘉车'
END AS FMachineTeam                       --设备组      
,o.CUSTOMER_CODE as FCustomerCode                  --客户代码
,ISNULL(m5.UDF021, '') as FCustomerContractNo      --客户合同号
,m1.CreateDate as FMoCreateDate                    --工单制单时间
,w1.WORK_CENTER_NAME as FWorkCenter                --科室
,CAST(CASE 
        WHEN ST.FItemCode IS NOT NULL THEN 1 
        ELSE 0 
END AS bit) AS FExistsStampTemplate
,CAST(CASE 
        WHEN CB.FItemCode IS NOT NULL THEN 1 
        ELSE 0 
END AS bit) AS FExistsAccessoryBom
,ISNULL([CQJH].dbo.GetValueByItemDesc(i1.ITEM_DESC, ';', '压力等级'),'') AS FPressureLevel
,ISNULL(QR.FQty,0) AS CYSQRCodeCount
,m2.UDF025 AS FValveSerialNumberBegin
,m2.UDF026 AS FValveSerialNumberEnd
,ISNULL(CSC.FContent,'http://www.cqjuhan.com') AS FCustomerStampContent
,ISNULL(SR.FinishedCount, 0) AS FMarkedCount
,CAST(CASE 
        WHEN vap.FNumber IS NOT NULL THEN 1 
        ELSE 0 
    END AS bit) AS FExistsValveAutoProcess
FROM CQJH.dbo.MO m1
INNER JOIN CQJH.dbo.MO_ROUTING m2 ON m1.MO_ID=m2.MO_ID
INNER JOIN CQJH.dbo.MO_ROUTING_D m3 ON m2.MO_ROUTING_ID=m3.MO_ROUTING_ID
INNER JOIN CQJH.dbo.MO_ROUTING_WORK_CENTER m4 ON  m3.MO_ROUTING_D_ID=m4.MO_ROUTING_D_ID AND m4.MAIN_STATION=1      --工作中心 - 主要
LEFT JOIN CQJH.dbo.MO_DEMAND m5 ON m1.MO_ID=m5.MO_ID            --需求信息
LEFT JOIN CQJH.dbo.SALES_ORDER_DOC_SD sdd on sdd.SALES_ORDER_DOC_SD_ID=m5.DEMAND_DOC_ROid   --订单子单身
LEFT JOIN CQJH.dbo.SALES_ORDER_DOC_D sd on sd.SALES_ORDER_DOC_D_ID = sdd.SALES_ORDER_DOC_D_ID  --订单单身
LEFT JOIN CQJH.dbo.SALES_ORDER_DOC s on s.SALES_ORDER_DOC_ID=sd.SALES_ORDER_DOC_ID         --订单单头
LEFT JOIN CQJH.dbo.CUSTOMER o ON  s.CUSTOMER_ID = o.CUSTOMER_BUSINESS_ID 
INNER JOIN CQJH.dbo.WORK_CENTER w1 ON m4.SOURCE_ID_ROid=w1.WORK_CENTER_ID
INNER JOIN CQJH.dbo.ITEM i1 ON m1.ITEM_ID=i1.ITEM_BUSINESS_ID
INNER JOIN CQJH.dbo.OPERATION o1 ON m3.OPERATION_ID=o1.OPERATION_ID
LEFT JOIN CQJH.dbo.MO_ROUTING_WIP m6 ON m3.MO_ROUTING_D_ID = m6.MO_ROUTING_D_ID  --工单工艺工作中心生产信息
INNER JOIN CQJH.dbo.ITEM_PLANT i2 ON i2.ITEM_ID=i1.ITEM_BUSINESS_ID
LEFT JOIN CQJH.dbo.ITEM_ROUTING_D ir1 ON ir1.ITEM_ROUTING_ID=i2.STANDARD_ROUTING_ID AND ir1.OPERATION_SEQ=m3.OPERATION_SEQ
LEFT JOIN coc.dbo.StampTemplateByItemCode ST ON i1.ITEM_CODE = ST.FItemCode
LEFT JOIN coc.dbo.CustomerStampContent CSC ON CSC.FCustomerCode = o.CUSTOMER_CODE
LEFT JOIN (SELECT FItemCode FROM CQJH.dbo.CX_BOM_Accessory GROUP BY FItemCode) CB ON i1.ITEM_CODE = CB.FItemCode
LEFT JOIN (select FBillNo, COUNT(FID) AS FQty from coc.dbo.[CYSQRCode] GROUP BY FBillNo) QR ON QR.FBillNo = m1.DOC_NO
LEFT JOIN (SELECT FBillNo, COUNT(*) AS FinishedCount FROM coc.dbo.StampRecord GROUP BY FBillNo) SR ON SR.FBillNo = m1.DOC_NO
LEFT JOIN coc.dbo.ValveAutoProcess vap ON vap.FNumber=i1.ITEM_CODE
LEFT JOIN v_MoInventoryStatus MIS ON m1.DOC_NO = MIS.工单号
WHERE 1=1
AND w1.WORK_CENTER_NAME = '制造四科'
AND m1.DOC_NO in ({0})
ORDER BY m1.PLAN_COMPLETE_DATE,m1.DOC_NO
</Value>
    </Setting>
    <Setting Name="sql_schedule_final_record_deleteall" Type="System.String" Scope="User">
      <Value Profile="(Default)">DELETE ScheduleFinalRecord
WHERE 1=1
AND FOperationPlanStartDate&gt;='{0}' AND FOperationPlanStartDate&lt;='{1}'
AND FUser = '{2}'
AND FClasses LIKE '%{3}%'</Value>
    </Setting>
    <Setting Name="v_MoInventoryStatus_D_find_by_mo" Type="System.String" Scope="User">
      <Value Profile="(Default)">select * from v_MoInventoryStatus_D where FBillNo = '{0}' AND FInventoryStatus&lt;&gt;'充足'</Value>
    </Setting>
    <Setting Name="sql_mo_d_find_by_billno" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT ITEM_CODE AS MaterialCode, CAST(REQUIRED_QTY AS decimal(18,3)) AS Quantity
FROM [CQJH].dbo.MO_D
INNER JOIN [CQJH].dbo.ITEM ON MO_D.ITEM_ID = ITEM.ITEM_BUSINESS_ID
INNER JOIN [CQJH].dbo.MO ON MO_D.MO_ID = MO.MO_ID
WHERE MO.DOC_NO = '{0}'</Value>
    </Setting>
    <Setting Name="v_StockAvailableQuantity_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM v_StockAvailableQuantity</Value>
    </Setting>
    <Setting Name="sql_stamp_record_silian_data_findall" Type="System.String" Scope="User">
      <Value Profile="(Default)">SELECT * FROM coc.dbo.StampRecordSilianData WHERE 1=1</Value>
    </Setting>
  </Settings>
</SettingsFile>